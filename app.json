{
  "expo": {
    "name": "Sinko",
    "slug": "sinko",
    "scheme": "sinko",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "bh.ioai.sinko",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Sinko finds the Sinko box on your home Wi‑Fi and talks to it there, to show and change your family’s rules.",
        "NSBonjourServices": [
          "_sinko._tcp",
          "_http._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "bh.ioai.sinko",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "ar"
          ]
        }
      ]
    ],
    "locales": {
      "en": "./locales/en.json",
      "ar": "./locales/ar.json"
    }
  }
}
